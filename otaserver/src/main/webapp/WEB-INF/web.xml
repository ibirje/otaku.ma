<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" version="3.1">
  
  <icon>
    <large-icon>webicon.png</large-icon>
  </icon>
  
  <listener>
    <listener-class>ma.otaku.servlets.OtakuContextListener</listener-class>
  </listener>
  
  <servlet>
    <servlet-name>Jersey Web Application</servlet-name>
    <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
    
    <init-param>
      <param-name>jersey.config.server.provider.packages</param-name>
      <param-value>
	      ma.otaku.controllersAdmin
	      ma.otaku.controllersPublic
	      ma.otaku.security
      </param-value>
    </init-param>
    
    <init-param>
      <param-name>javax.ws.rs.Application</param-name>
      <param-value>ma.otaku.security.SecurityConfig</param-value>
    </init-param>

    <init-param>
      <param-name>javax.ws.rs.container.ContainerRequestFilter</param-name>
      <param-value>
		ma.otaku.security.PublicAuthenticationFilter;
		ma.otaku.security.AuthenticationFilter;
		org.glassfish.jersey.filter.LoggingFilter;
	  </param-value>
    </init-param>

    <init-param>
      <param-name>javax.ws.rs.container.ContainerResponseFilters</param-name>
      <param-value>
		    ma.otaku.security.CorsFilter;
		  	org.glassfish.jersey.filter.LoggingFilter;
	  </param-value>
    </init-param>

    <load-on-startup>1</load-on-startup>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>Jersey Web Application</servlet-name>
    <url-pattern>/app/*</url-pattern>
  </servlet-mapping>
 
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>All</web-resource-name>
      <url-pattern>/*</url-pattern>
    </web-resource-collection>
    <user-data-constraint>
      <transport-guarantee>CONFIDENTIAL</transport-guarantee>
    </user-data-constraint>
  </security-constraint>
  
</web-app>